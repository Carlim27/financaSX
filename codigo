<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FinançaSX</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

:root{
  --bg:#0b1220;
  --card:#111a2e;
  --accent:#38bdf8;
  --text:#e5e7eb;
  --green:#22c55e;
  --red:#ef4444;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial;
}

body{
  background:var(--bg);
  color:var(--text);
  overflow-x:hidden;
  transition:.3s;
}

/* FUNDO */
canvas#bg{
  position:fixed;
  top:0;
  left:0;
  z-index:0;
  pointer-events:none;
}

.container{
  position:relative;
  z-index:1;
  max-width:1100px;
  margin:auto;
  padding:30px 20px;
}

/* HEADER */

header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

header h1{
  color:var(--accent);
}

#icon{
  font-size:30px;
}

/* CARDS */

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px;
}

.card{
  background:var(--card);
  padding:20px;
  border-radius:14px;
  transition:.2s;
}

.card:hover{
  transform:translateY(-5px);
}

.value{
  font-size:22px;
  margin-top:10px;
}

.green{
  color:var(--green);
}

.red{
  color:var(--red);
}

/* FORM */

.form{
  margin-top:20px;
  background:var(--card);
  padding:20px;
  border-radius:14px;
  display:grid;
  gap:10px;
}

input,
select,
button{
  padding:12px;
  border:none;
  border-radius:10px;
}

input,
select{
  background:#0f172a;
  color:white;
}

button{
  background:var(--accent);
  color:white;
  cursor:pointer;
  font-weight:bold;
  transition:.2s;
}

button:hover{
  opacity:.9;
}

/* LISTA */

.item{
  background:var(--card);
  margin-top:10px;
  padding:15px;
  border-radius:12px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.small{
  opacity:.6;
  font-size:12px;
}

/* ALERTAS */

.alert{
  margin-top:10px;
  padding:10px;
  border-radius:10px;
}

.redA{
  background:#7f1d1d;
}

.yellowA{
  background:#78350f;
}

/* GRÁFICO */

canvas.chart{
  margin-top:20px;
  background:var(--card);
  padding:15px;
  border-radius:14px;
}

#chart{
  margin-top:20px;
  background:var(--card);
  padding:20px;
  border-radius:14px;
}

</style>
</head>

<body>

<canvas id="bg"></canvas>

<div class="container">

<header>
  <h1>FinançaSX</h1>
  <div id="icon">💸</div>
</header>

<div class="cards">

  <div class="card">
    <div>SALDO</div>
    <div class="value" id="saldo">R$ 0</div>
  </div>

  <div class="card">
    <div>ENTRADAS</div>
    <div class="value green" id="entradas">R$ 0</div>
  </div>

  <div class="card">
    <div>SAÍDAS</div>
    <div class="value red" id="saidas">R$ 0</div>
  </div>

</div>

<div id="alert"></div>

<div class="form">

  <input id="desc" placeholder="Descrição">

  <input
    id="valor"
    type="number"
    min="0"
    placeholder="Valor"
  >

  <select id="tipo">
    <option value="entrada">Entrada</option>
    <option value="saida">Saída</option>
  </select>

  <select id="cat">
    <option>Geral</option>
    <option>Alimentação</option>
    <option>Transporte</option>
    <option>Lazer</option>
    <option>Saúde</option>
  </select>

  <button onclick="add()">
    Adicionar
  </button>

</div>

<div id="list"></div>

<canvas id="chart"></canvas>

</div>

<script>

/* ================= DADOS ================= */

let data = [];
localStorage.removeItem("fxUltra");

let chart;

/* ================= FORMATAR ================= */

function format(v){

  return v.toLocaleString(
    "pt-BR",
    {
      style:"currency",
      currency:"BRL"
    }
  );

}

/* ================= ADICIONAR ================= */

function add(){

  let d =
  document.getElementById("desc").value;

  let v =
  parseFloat(
    document.getElementById("valor").value
  );

  let t =
  document.getElementById("tipo").value;

  let c =
  document.getElementById("cat").value;

  if(!d || isNaN(v) || v < 0){
    return;
  }

  data.push({
    d,
    v,
    t,
    c
  });

  save();
  update();

  document.getElementById("desc").value="";
  document.getElementById("valor").value="";

}

/* ================= SALVAR ================= */

function save(){

  localStorage.setItem(
    "fxUltra",
    JSON.stringify(data)
  );

}

/* ================= UPDATE ================= */

function update(){

  let e = 0;
  let s = 0;

  let list =
  document.getElementById("list");

  list.innerHTML = "";

  data.forEach(x=>{

    if(x.t==="entrada"){
      e += x.v;
    }else{
      s += x.v;
    }

    let div =
    document.createElement("div");

    div.className="item";

    div.innerHTML = `
      <div>
        <strong>${x.d}</strong>
        <div class="small">${x.c}</div>
      </div>

      <div>
        ${format(x.v)}
      </div>
    `;

    list.appendChild(div);

  });

  let saldo = e - s;

  document.getElementById("saldo")
  .innerText = format(saldo);

  document.getElementById("entradas")
  .innerText = format(e);

  document.getElementById("saidas")
  .innerText = format(s);

  let alert =
  document.getElementById("alert");

  alert.innerHTML = "";

  if(saldo < 0){

    alert.innerHTML = `
      <div class="alert redA">
        ⚠ Saldo negativo
      </div>
    `;

  }

  else if(saldo < 100){

    alert.innerHTML = `
      <div class="alert yellowA">
        ⚠ Saldo baixo
      </div>
    `;

  }

  if(chart){
    chart.destroy();
  }

  chart = new Chart(
    document.getElementById("chart"),
    {
      type:"doughnut",

      data:{
        labels:[
          "Entradas",
          "Saídas"
        ],

        datasets:[
          {
            data:[e,s]
          }
        ]
      }
    }
  );

  save();

}

/* ================= TEMA AUTOMÁTICO ================= */

function applyTheme(){

  const root =
  document.documentElement;

  const icon =
  document.getElementById("icon");

  const hour =
  new Date().getHours();

  if(hour >= 18 || hour < 6){

    icon.innerText="🌙";

    root.style.setProperty(
      "--bg",
      "#070a12"
    );

    root.style.setProperty(
      "--card",
      "#111827"
    );

    root.style.setProperty(
      "--accent",
      "#818cf8"
    );

  }else{

    icon.innerText="☀️";

    root.style.setProperty(
      "--bg",
      "#0b1220"
    );

    root.style.setProperty(
      "--card",
      "#111a2e"
    );

    root.style.setProperty(
      "--accent",
      "#38bdf8"
    );

  }

}

applyTheme();

/* ================= PARTICLES ================= */

const canvas =
document.getElementById("bg");

const ctx =
canvas.getContext("2d");

canvas.width = innerWidth;
canvas.height = innerHeight;

let p = [];

for(let i=0;i<80;i++){

  p.push({

    x:Math.random()*canvas.width,
    y:Math.random()*canvas.height,

    vx:0,
    vy:0

  });

}

document.addEventListener(
  "mousemove",
  e=>{

    p.forEach(o=>{

      let dx =
      o.x - e.clientX;

      let dy =
      o.y - e.clientY;

      let d =
      Math.sqrt(dx*dx + dy*dy);

      if(d < 120){

        o.vx += dx/d;
        o.vy += dy/d;

      }

    });

  }
);

function anim(){

  ctx.clearRect(
    0,
    0,
    canvas.width,
    canvas.height
  );

  p.forEach(o=>{

    o.x += o.vx;
    o.y += o.vy;

    o.vx *= 0.92;
    o.vy *= 0.92;

    ctx.fillStyle =
    "#38bdf8";

    ctx.fillRect(
      o.x,
      o.y,
      2,
      2
    );

  });

  requestAnimationFrame(anim);

}

anim();

/* ================= RESPONSIVO ================= */

window.addEventListener(
  "resize",
  ()=>{

    canvas.width = innerWidth;
    canvas.height = innerHeight;

  }
);

/* ================= INIT ================= */

update();

</script>

</body>
</html>
